# Use a unique password of at least 16 characters. See README for setup.
SHELFSHUTTLE_ADMIN_PASSWORD=
# Use true behind HTTPS. Set false only for loopback HTTP development.
SHELFSHUTTLE_COOKIE_SECURE=true
# Authenticated requests can also use an optional API bearer token (32+ characters).
# SHELFSHUTTLE_API_TOKEN=
# SHELFSHUTTLE_PORT=8080
# SHELFSHUTTLE_PUID=10001
# SHELFSHUTTLE_PGID=10001
# SHELFSHUTTLE_DOWNLOADS_SOURCE=/path/to/downloads
# SHELFSHUTTLE_AUDIOBOOK_SOURCE=/path/to/audiobook-parent
# SHELFSHUTTLE_EBOOK_SOURCE=/path/to/ebook-parent
# SHELFSHUTTLE_QBIT_URL=http://qbittorrent:8080
# SHELFSHUTTLE_QBIT_USERNAME=
# SHELFSHUTTLE_QBIT_PASSWORD=
# SHELFSHUTTLE_REMOTE_DOWNLOAD_ROOT=/downloads
# SHELFSHUTTLE_DRY_RUN=false
